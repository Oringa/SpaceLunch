{
  "name": "centrifuge-kinetic-launch",
  "private": true,
  "version": "0.1.0",
  "description": "CENTRIFUGE: a browser-based kinetic-launch engineering game with a reduced-order aerospace simulation.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "docs:params": "node scripts/gen-parameter-dictionary.mjs",
    "reference": "vitest run src/tests/missions.test.ts"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.0.18"
  }
}
